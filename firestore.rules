rules_version = '2';

// Cada usuario pertenece a un "hogar" (members/{UID}):
//  - Hogar familiar original: members/{UID} SIN campo householdId (creados a
//    mano en la consola). Sus datos están en las colecciones de la raíz.
//  - Hogares nuevos: members/{UID}.householdId == UID, creado por la propia
//    cuenta al registrarse. Sus datos están en households/{UID}/...
// Ningún hogar puede leer ni escribir los datos de otro.
service cloud.firestore {
  match /databases/{database}/documents {

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function hasMember() {
      return request.auth != null && exists(memberPath());
    }

    // Miembro del hogar familiar original (colecciones de la raíz).
    function isMember() {
      return hasMember() && !('householdId' in get(memberPath()).data);
    }

    // Miembro de un hogar nuevo.
    function inHousehold(hid) {
      return hasMember() && get(memberPath()).data.get('householdId', null) == hid;
    }

    function validCategory(d) {
      return d.keys().hasOnly(['id', 'name', 'budget', 'color', 'icon'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.budget is number && d.budget >= 0
        && d.color is string && d.icon is string;
    }

    function validExpense(d) {
      return d.keys().hasOnly(['amount', 'description', 'categoryId', 'date', 'userId', 'userName', 'paymentMethod'])
        && (!('paymentMethod' in d) || d.paymentMethod in ['salary', 'credit'])
        && d.amount is number && d.amount > 0
        && d.description is string && d.description.size() <= 200
        && d.categoryId is string
        && d.date is string
        && d.userName is string;
    }

    function validIncome(d) {
      return d.keys().hasOnly(['amount', 'description', 'period', 'createdAt', 'userId', 'userName'])
        && d.amount is number && d.amount > 0
        && d.description is string && d.description.size() <= 100
        && d.period is string && d.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.createdAt is string
        && d.userName is string;
    }

    match /incomes/{incomeId} {
      allow read: if isMember();
      allow create: if isMember()
        && validIncome(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isMember();
    }

    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Una cuenta nueva solo puede crear su propio registro, apuntando a su
      // propio hogar: no puede unirse al hogar de otra persona.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId', 'email', 'createdAt'])
        && request.resource.data.householdId == uid;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow read: if inHousehold(hid);
      allow create: if request.auth != null && request.auth.uid == hid
        && request.resource.data.keys().hasOnly(['ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;

      match /categories/{catId} {
        allow read: if inHousehold(hid);
        allow create, update: if inHousehold(hid) && validCategory(request.resource.data);
        allow delete: if inHousehold(hid);
      }

      match /expenses/{expId} {
        allow read: if inHousehold(hid);
        allow create: if inHousehold(hid)
          && validExpense(request.resource.data)
          && request.resource.data.userId == request.auth.uid;
        allow update: if inHousehold(hid)
          && validExpense(request.resource.data)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if inHousehold(hid);
      }

      match /incomes/{incomeId} {
        allow read: if inHousehold(hid);
        allow create: if inHousehold(hid)
          && validIncome(request.resource.data)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if inHousehold(hid);
      }
    }

    // Plantilla de categorías para cuentas nuevas: la publica el hogar
    // familiar y la puede leer cualquier cuenta registrada.
    match /config/categoryTemplate {
      allow read: if request.auth != null;
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 50;
    }

    match /categories/{catId} {
      allow read: if isMember();
      allow create, update: if isMember() && validCategory(request.resource.data);
      allow delete: if isMember();
    }

    match /expenses/{expId} {
      allow read: if isMember();
      // Cada quien registra gastos a su propio nombre.
      allow create: if isMember()
        && validExpense(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      // Ambos miembros pueden corregir o borrar, sin cambiar el autor.
      allow update: if isMember()
        && validExpense(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isMember();
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
